<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         cacheDirectory=".phpunit.cache"
         colors="true"
         failOnRisky="true"
         failOnWarning="true"
         executionOrder="depends,defects">
    <php>
        <!-- Fixture repos are built with git in the test process; keep the developer's
             ~/.gitconfig and /etc/gitconfig (signing, hooks, templates) out of them. -->
        <env name="GIT_CONFIG_GLOBAL" value="/dev/null" force="true"/>
        <env name="GIT_CONFIG_NOSYSTEM" value="1" force="true"/>
    </php>
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
        <testsuite name="Scenario">
            <directory>tests/Scenario</directory>
        </testsuite>
        <testsuite name="Integration">
            <directory>tests/Integration</directory>
        </testsuite>
        <testsuite name="RealLaravel">
            <directory>tests/RealLaravel</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>src</directory>
        </include>
    </source>
</phpunit>
