{
    "name": "jay-brainbean/cpdeploy",
    "description": "Menu-driven tool that deploys GitHub repositories to a cPanel account using releases and an atomic switch.",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": "^8.1",
        "ext-mbstring": "*",
        "composer/semver": "^3.4",
        "laravel/prompts": "^0.3.24",
        "symfony/console": "^6.4",
        "symfony/process": "^6.4",
        "symfony/yaml": "^6.4"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.64",
        "phpstan/phpstan": "^2.0",
        "phpunit/phpunit": "^10.5"
    },
    "suggest": {
        "ext-pcntl": "Animated spinners and graceful Ctrl+C handling",
        "ext-posix": "Process-group termination on timeout and cancel"
    },
    "autoload": {
        "psr-4": {
            "Cpdeploy\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Cpdeploy\\Tests\\": "tests/"
        }
    },
    "bin": ["bin/cpdeploy"],
    "config": {
        "platform": {
            "php": "8.1.0"
        },
        "sort-packages": true,
        "optimize-autoloader": true
    },
    "scripts": {
        "test": "phpunit",
        "stan": "phpstan analyse --memory-limit=1G",
        "cs": "php-cs-fixer fix --dry-run --diff",
        "cs-fix": "php-cs-fixer fix"
    }
}
